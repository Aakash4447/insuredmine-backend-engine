{
  "info": {
    "name": "InsuredMine Interview API",
    "description": "Collection for the Express + Mongoose backend. Run Login first to populate {{token}}. All folders except \"Planned\" map to implemented routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "username",
      "value": "John"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Get version",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "version"
              ]
            },
            "description": "Public. Returns the package version."
          }
        }
      ]
    },
    {
      "name": "Auth and Users",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "register"
              ]
            },
            "description": "Public. Creates a USER-role account. Requires name, email and password. 409 if the email already exists."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response contains accessToken\", () => pm.expect(body.data.accessToken).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", body.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            },
            "description": "Public. Returns user, accessToken and refreshToken. The test script saves them into the collection variables token and refreshToken. Set the email and password collection variables first (boot seeding creates dummy users, see src/boot/data/dummy-users.js)."
          }
        },
        {
          "name": "Get current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "me"
              ]
            },
            "description": "Returns the authenticated user (any role)."
          }
        },
        {
          "name": "List users (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "list"
              ]
            },
            "description": "ADMIN only. 403 for USER role."
          }
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "Upload policies XLSX/CSV (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "upload"
              ]
            },
            "description": "ADMIN only. Multipart form-data, single file field named \"file\" (.xlsx or .csv, max 20 MB). Parsed and imported in a worker thread into the agents, users (policy holders), user accounts, policy categories, policy carriers and policy infos collections. Pick a file in Postman after importing; no path is stored. Recognised headers (case and underscore insensitive): agent, userType, policy_number, company_name, category_name, policy_start_date, policy_end_date, account_name, email, gender, firstname, phone, address, state, zip, dob. Required per row: policy number, company name, category name, start date, end date, email, first name.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Search policies by username",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test(\"Has pagination\", () => pm.expect(pm.response.json().data.pagination).to.be.an(\"object\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/search?username={{username}}&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Search policy info by user name (required). ADMIN searches all holders; USER only the holder with their own email. Pagination: page (default 1), limit (default 10, max 100)."
          }
        },
        {
          "name": "Aggregate policies by user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test(\"Has users array\", () => pm.expect(pm.response.json().data.users).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/aggregate-by-user?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "aggregate-by-user"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Aggregated policies per user. ADMIN sees all holders; USER only their own. Pagination: page, limit (max 100)."
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Schedule message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello from Postman\",\n  \"day\": \"2030-01-15\",\n  \"time\": \"09:30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/messages/schedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages",
                "schedule"
              ]
            },
            "description": "Stores the message in the scheduled messages collection and inserts it at the given day and time. day is YYYY-MM-DD, time is HH:mm, both read as UTC, and must be in the future (else 400). Returns 201."
          }
        }
      ]
    },
    {
      "name": "Planned (not implemented)",
      "description": "Placeholders for task requirements with no HTTP endpoint yet. Request shapes are proposals and return 404 until implemented.",
      "item": [
        {
          "name": "[PLANNED] CPU status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/cpu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "cpu"
              ]
            },
            "description": "PLANNED, not implemented. CPU monitoring exists internally (src/utils/cpu-monitor.js; the process exits on threshold so a process manager restarts it) but no route exposes it. Proposed response: { currentPercent, thresholdPercent: 70, sampledAt }. Likely ADMIN only."
          }
        }
      ]
    }
  ]
}